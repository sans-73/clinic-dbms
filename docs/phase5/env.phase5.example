
# ---- Phase 5 web app (append to .env; MYSQL_ROOT_PASSWORD already exists above) ----
# DB_MODE: dev = one MySQL account (root) for everything | roles = one account per role (after P3-7) | stub = no database
DB_MODE=dev
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=clinic_db
DB_USER=root
# DB_PASSWORD defaults to MYSQL_ROOT_PASSWORD
APP_TIMEZONE=Asia/Kolkata
PUBLIC_BASE_URL=http://localhost:8000
APP_DEBUG=1
# roles mode only (P3-7 creates these accounts), example:
# DB_USER_DOCTOR=clinic_doctor
# DB_PASSWORD_DOCTOR=...
